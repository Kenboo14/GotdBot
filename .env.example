# Create .env from this file and set your bot token from @BotFather.
API_ID=
API_HASH=
BOT_TOKEN=
# Use a strong value outside local development.
REDIS_PASS=change-me-for-local-dev
MONGO_DB=gotdbot
# MongoDB connection string. For Atlas use mongodb+srv://...; local Docker uses mongodb://mongo:27017.
MONGO_URI=mongodb://mongo:27017
# Create an app at https://my.telegram.org/apps. These are server credentials,
# shared by all installed accounts; never send them through Telegram chat.
API_ID=
API_HASH=
# 32 random bytes encoded as base64. Generate once and keep it safe:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_ENCRYPTION_KEY=
