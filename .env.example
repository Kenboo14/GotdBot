# ==========================================
# Telegram Credentials
# ==========================================
API_ID=
API_HASH=
BOT_TOKEN=
SESSION_ENCRYPTION_KEY=

# ==========================================
# Broker (Redis)
# ==========================================
REDIS_ADDR=localhost:6379
REDIS_PASS=change-me-for-local-dev
REDIS_TLS=false

# ==========================================
# Primary Database (Pure-Go SQLite)
# Di Docker (VPS), otomatis tersimpan di folder ./data/userbot.db
# Di Windows (Lokal), disarankan data/userbot.db
# ==========================================
SQLITE_PATH=data/userbot.db

# ==========================================
# Remote Offsite Backup (MongoDB Cloud Atlas - Optional)
# ==========================================
MONGO_BACKUP_URI=
MONGO_BACKUP_DB=gotdbot_backup

# ==========================================
# Cache & Monitoring (Notes Live Reply)
# ==========================================
GROUP_CACHE=AiotdCaches
NOTES_CACHE=7157
TEKS_CACHE=3325
TOPIC_CACHE=

# ==========================================
# Resource Tuning & Warm Pool (1 vCPU / 2GB)
# ==========================================
NORMAL_WORKER_MAX_SESSIONS=100
HELL_WORKER_MAX_SESSIONS=50
# Lightweight MTProto AuthKey validation interval. Minimum: 15 seconds.
SESSION_HEARTBEAT_SECONDS=60
GATEWAY_GOMEMLIMIT=85MiB
GOGC=30
