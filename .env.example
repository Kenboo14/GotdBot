# ==========================================
# Telegram Credentials
# ==========================================
API_ID=
API_HASH=
BOT_TOKEN=
SESSION_ENCRYPTION_KEY=

# ==========================================
# Broker (Redis)
# ==========================================
REDIS_ADDR=localhost:6379
REDIS_PASS=change-me-for-local-dev
REDIS_TLS=false

# ==========================================
# Primary Database (Pure-Go SQLite)
# ==========================================
SQLITE_PATH=userbot.db

# ==========================================
# Remote Offsite Backup (MongoDB Cloud Atlas - Optional)
# ==========================================
MONGO_BACKUP_URI=
MONGO_BACKUP_DB=gotdbot_backup

# ==========================================
# Cache & Monitoring (Notes Live Reply)
# ==========================================
GROUP_CACHE=AiotdCaches
NOTES_CACHE=7157

# ==========================================
# Resource Tuning (Target 500 MTProto)
# ==========================================
MAX_ACTIVE_SESSIONS=550
GOMEMLIMIT=1100MiB
GOGC=50
