services:
  redis:
    image: redis:7-alpine
    container_name: redis
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes --requirepass PastiKaya
    restart: always

  gateway:
    build:
      context: ./gateway  # Docker akan masuk ke folder gateway
      dockerfile: Dockerfile
    container_name: gateway_app
    depends_on:
      - redis
    environment:
      - REDIS_ADDR=island-turbofast-string-59543.db.redis.io:11280
      - REDIS_PASS=AioGo
    restart: always

  ubot:
    build:
      context: ./ubot    # Docker akan masuk ke folder ubot
      dockerfile: Dockerfile
    container_name: ubot_app
    depends_on:
      - redis
    environment:
      - REDIS_ADDR=island-turbofast-string-59543.db.redis.io:11280
      - REDIS_PASS=AioGo
    restart: always

volumes:
  redis_data: